# Telegram API (получить на https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram Bot для отправки сигналов
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Канал для парсинга
TELEGRAM_CHANNEL=https://t.me/D_LAKTIONOV_LIVE

# AI Аналитик (Fireworks.ai / DeepSeek V4 Pro)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro

# Настройки ATR
ATR_THRESHOLD_PERCENT=1.0

# Время утреннего анализа (МСК)
MORNING_CHECK_HOUR=6
MORNING_CHECK_MINUTE=0

# Интервал проверки цен во время торгов (секунды)
PRICE_CHECK_INTERVAL=60

# Торговые правила
# Тейк: +0.9-1.5%, Стоп: -0.3%
# Не торгуем после 14:00 МСК
# Мин объём инструмента: 300 млн руб
# Не шортим вчерашних лидеров падения
# Не лонгуем вчерашних лидеров роста
