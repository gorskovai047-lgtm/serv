# ═══ TELEGRAM ═══
# Получить на https://my.telegram.org (для парсинга канала Лактионова)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Бот для отправки сигналов (создать через @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Канал для парсинга
TELEGRAM_CHANNEL=https://t.me/D_LAKTIONOV_LIVE

# ═══ AI АНАЛИТИК ═══
# Fireworks.ai — DeepSeek V4 Pro (зарегаться на fireworks.ai, получить ключ)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro

# ═══ РАСПИСАНИЕ (МСК) ═══
# Утренний план — за 15 мин до открытия срочки
PRE_OPEN_HOUR=6
PRE_OPEN_MINUTE=45

# Подтверждение первым баром — через 5 мин после открытия
CONFIRM_DELAY_MINUTES=5

# Интервал проверки цен (секунды). 30 = быстрая реакция
PRICE_CHECK_INTERVAL=30

# ═══ ТОРГОВЫЕ ПРАВИЛА ═══
# ATR порог (1% = стандартный дневной ход)
ATR_THRESHOLD_PERCENT=1.0

# Правила (зашиты в логику, не меняются через .env):
# Тейк: +0.9-1.5%, Стоп: -0.3%
# Не торгуем после 14:00 МСК
# Мин объём инструмента: 300 млн руб
# Не шортим вчерашних лидеров падения (> -1.5%)
# Не лонгуем вчерашних лидеров роста (> +1.5%)
# Перезаход после ложного выноса: 1 раз, через 5-30 мин, ATR < 60%
